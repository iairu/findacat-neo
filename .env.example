# Environment variables for a Vercel deployment. Set them under Project → Settings →
# Environment Variables (the page accepts a pasted .env file); none are required.
# For shared hosting see api/.env.example instead.
#
# Generated automatically when unset (stored in the database, the same for every deployment):
#   APP_KEY          encryption key
#   INSTALL_TOKEN    setup page token, printed with the setup link in the build log until an admin exists
#
# Database: connecting Neon (Storage → Neon) sets DATABASE_URL / POSTGRES_URL, which are used
# automatically. For another database set DB_URL, e.g. mysql://user:pass@host:3306/findacat
DB_URL=

# Shown in emails.
APP_NAME="Find A Cat"

# Only for a custom domain; defaults to the project's production vercel.app address.
APP_URL=

# SMTP for confirmation and password-reset emails. Without it emails only go to the function log.
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=cats@example.com

# true or 1 closes registration; existing accounts keep working.
DISABLE_SIGNUPS=false
