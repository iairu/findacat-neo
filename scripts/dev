#!/usr/bin/env bash
# Runs the Astro site and the Laravel API together for local development.
#
#   scripts/dev          # API on http://localhost:8000 + Astro on http://localhost:4321
#   scripts/dev api      # API only
#   scripts/dev web      # Astro only (expects an API on :8000)
#   scripts/dev setup    # install dependencies, create .env, key and database, then exit
#
# PHP and Composer are used when installed; otherwise the commands run through the
# `composer:2` Docker image. The Astro dev server proxies /api to :8000 (see
# web/astro.config.mjs), so the API port stays 8000.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
API_DIR="$ROOT/api"
WEB_DIR="$ROOT/web"
API_PORT="${API_PORT:-8000}"
WEB_PORT="${WEB_PORT:-4321}"
API_CONTAINER="findacat-api-dev"

# Let Ctrl+C stop the servers as a group.
set -m

usage() {
  sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'
}

say() { printf '\033[1m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[33mwarning:\033[0m %s\n' "$*" >&2; }
die() { printf '\033[31merror:\033[0m %s\n' "$*" >&2; exit 1; }

need_docker() {
  command -v docker >/dev/null 2>&1 || die "PHP is not installed and Docker is not available. Install PHP 8.3+ or Docker."
}

have_local_php() { command -v php >/dev/null 2>&1; }
have_local_composer() { command -v composer >/dev/null 2>&1; }

run_php() {
  if have_local_php; then
    (cd "$API_DIR" && php "$@")
  else
    need_docker
    docker run --rm -u "$(id -u):$(id -g)" -e HOME=/tmp -e COMPOSER_HOME=/tmp/composer \
      -v "$API_DIR:/app" -w /app composer:2 php "$@"
  fi
}

run_artisan() { run_php artisan "$@"; }

run_composer() {
  if have_local_composer; then
    (cd "$API_DIR" && composer "$@")
  else
    need_docker
    docker run --rm -u "$(id -u):$(id -g)" -e HOME=/tmp -e COMPOSER_HOME=/tmp/composer \
      -v "$API_DIR:/app" -w /app composer:2 composer "$@"
  fi
}

ensure_env() {
  local key="$1" value="$2"
  grep -Eq "^[[:space:]]*${key}=" "$API_DIR/.env" || printf '\n%s=%s\n' "$key" "$value" >> "$API_DIR/.env"
}

bootstrap_api() {
  mkdir -p "$API_DIR/storage/logs" \
    "$API_DIR/storage/framework/cache/data" "$API_DIR/storage/framework/sessions" \
    "$API_DIR/storage/framework/views" "$API_DIR/bootstrap/cache"

  if [[ ! -f "$API_DIR/.env" ]]; then
    say "Creating api/.env from .env.example (SQLite)"
    cp "$API_DIR/.env.example" "$API_DIR/.env"
    # A local checkout should not need a MySQL server; tests already use SQLite.
    sed -i.bak 's/^DB_CONNECTION=mysql/DB_CONNECTION=sqlite/' "$API_DIR/.env"
    rm -f "$API_DIR/.env.bak"
  fi

  if [[ ! -f "$API_DIR/vendor/autoload.php" ]]; then
    say "Installing API dependencies"
    run_composer install --no-interaction --prefer-dist
  fi

  if ! grep -Eq '^APP_KEY=base64:.+' "$API_DIR/.env"; then
    say "Generating APP_KEY"
    run_artisan key:generate --force
  fi

  # The API and site share a host in production; locally the Astro dev server proxies /api.
  ensure_env FRONTEND_URL "http://localhost:$WEB_PORT"
  ensure_env SANCTUM_STATEFUL_DOMAINS "localhost:$WEB_PORT,localhost:$API_PORT"

  if grep -Eq '^DB_CONNECTION=sqlite' "$API_DIR/.env"; then
    mkdir -p "$API_DIR/database"
    [[ -f "$API_DIR/database/database.sqlite" ]] || touch "$API_DIR/database/database.sqlite"
  fi

  say "Running API migrations"
  if ! run_artisan migrate --force; then
    die "Migrations failed. Check DB_* in api/.env, or set DB_CONNECTION=sqlite for a local database."
  fi
}

bootstrap_web() {
  if [[ ! -d "$WEB_DIR/node_modules" ]]; then
    say "Installing web dependencies"
    if [[ -f "$WEB_DIR/package-lock.json" ]]; then
      (cd "$WEB_DIR" && npm ci --silent)
    else
      (cd "$WEB_DIR" && npm install --silent)
    fi
  fi
}

API_PID=""
WEB_PID=""
API_IN_DOCKER=0

cleanup() {
  trap - EXIT INT TERM
  [[ -n "$WEB_PID" ]] && kill -- "-$WEB_PID" 2>/dev/null || true
  [[ -n "$API_PID" ]] && kill -- "-$API_PID" 2>/dev/null || true
  if [[ "$API_IN_DOCKER" == 1 ]]; then
    docker rm -f "$API_CONTAINER" >/dev/null 2>&1 || true
  fi
  wait 2>/dev/null || true
}
trap cleanup EXIT INT TERM

start_api() {
  if port_in_use "$API_PORT"; then
    die "Port $API_PORT is already in use. Stop the other server and retry."
  fi
  say "Starting Laravel API on http://localhost:$API_PORT"
  if have_local_php; then
    (cd "$API_DIR" && exec php artisan serve --host=127.0.0.1 --port="$API_PORT") &
    API_PID=$!
  else
    need_docker
    docker rm -f "$API_CONTAINER" >/dev/null 2>&1 || true
    docker run --rm --name "$API_CONTAINER" \
      -u "$(id -u):$(id -g)" -e HOME=/tmp -e COMPOSER_HOME=/tmp/composer \
      -v "$API_DIR:/app" -w /app \
      -p "127.0.0.1:$API_PORT:8000" \
      composer:2 php artisan serve --host=0.0.0.0 --port=8000 &
    API_PID=$!
    API_IN_DOCKER=1
  fi
}

start_web() {
  if port_in_use "$WEB_PORT"; then
    die "Port $WEB_PORT is already in use. Stop the other server (for an old Astro daemon: npm --prefix web run astro -- dev stop) and retry."
  fi
  say "Starting Astro on http://localhost:$WEB_PORT"
  # --ignore-lock keeps Astro in the foreground when it detects an agent/editor shell,
  # so this script owns the process and Ctrl+C stops it.
  (cd "$WEB_DIR" && exec env API_ORIGIN="http://localhost:$API_PORT" \
    npm run dev -- --port "$WEB_PORT" --ignore-lock) &
  WEB_PID=$!
}

wait_for_api() {
  command -v curl >/dev/null 2>&1 || { sleep 2; return; }
  for _ in $(seq 1 60); do
    if curl -fsS "http://127.0.0.1:$API_PORT/api/health" >/dev/null 2>&1; then
      say "API is ready"
      return
    fi
    kill -0 "$API_PID" 2>/dev/null || die "The API server stopped during startup. See the output above."
    sleep 0.5
  done
  warn "The API did not answer yet; Astro starts anyway and the proxy will retry."
}

port_in_use() {
  (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null
}

case "${1:-all}" in
  all)
    bootstrap_api
    bootstrap_web
    start_api
    wait_for_api
    start_web
    echo
    printf '  Astro  http://localhost:%s\n  API    http://localhost:%s/api/health\n\n' "$WEB_PORT" "$API_PORT"
    echo "Press Ctrl+C to stop both."
    while kill -0 "$API_PID" 2>/dev/null && kill -0 "$WEB_PID" 2>/dev/null; do sleep 1; done
    ;;
  api)
    bootstrap_api
    start_api
    echo
    printf '  API  http://localhost:%s/api/health\n\n' "$API_PORT"
    echo "Press Ctrl+C to stop."
    wait "$API_PID"
    ;;
  web)
    bootstrap_web
    start_web
    echo
    printf '  Astro  http://localhost:%s\n\n' "$WEB_PORT"
    echo "Press Ctrl+C to stop."
    wait "$WEB_PID"
    ;;
  setup)
    bootstrap_api
    bootstrap_web
    say "Local setup complete. Run scripts/dev (or npm run dev) to start both servers."
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    usage >&2
    exit 1
    ;;
esac
